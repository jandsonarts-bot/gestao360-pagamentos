rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function logado() { return request.auth != null; }

    // Uso individual: cada conta só lê e grava os próprios dados.
    match /users/{uid}/{document=**} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Equipe: o dono (id do documento = uid dele) define os e-mails com acesso.
    match /equipes/{dono} {
      allow read: if logado() && request.auth.token.email_verified && email() in resource.data.membros;
      allow create, update: if logado() && request.auth.uid == dono
                            && request.resource.data.dono == dono
                            && request.resource.data.membros is list
                            && request.resource.data.membros.size() <= 30;
      allow delete: if logado() && request.auth.uid == dono;

      // Dados compartilhados: qualquer membro lê e grava.
      match /dados/{doc} {
        allow read, write: if logado() && request.auth.token.email_verified
          && email() in get(/databases/$(database)/documents/equipes/$(dono)).data.membros;
      }
    }
  }
}
